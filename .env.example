DJANGO_SECRET_KEY=replace-this-with-a-unique-random-secret-of-at-least-64-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-domain.example
POSTGRES_DB=capacity_connect
POSTGRES_USER=capacity_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://capacity_user:change-this-password@db:5432/capacity_connect
VITE_API_BASE_URL=/api
APP_PORT=8080

# PayPal sandbox credentials (configure in backend/.env; never commit real values)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PLATFORM_FEE_PERCENT=1
FRONTEND_URL=http://localhost:5173

# Production deployment: terminate HTTPS at a trusted reverse proxy before enabling SSL redirect/HSTS.
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=False
API_ANON_RATE=100/hour
API_USER_RATE=1200/hour
LOG_LEVEL=INFO
